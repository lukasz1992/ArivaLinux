From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz M <lukasz1992m+alilinux@gmail.com>
Date: Sun, 22 Nov 2026 12:41:19 +0100
Subject: [PATCH] mips: ali-c3503d: USB wrapper/PHY initialisation and
 EHCI device

Without the vendor's wrapper and PHY set-up the EHCI core answers but every
transaction ends in an error interrupt.  The sequence follows the vendor
maincode (FUN_805cdc58) and the PDK U-Boot ehci-ali.c, with the PHY
calibration taken from OTP byte 900.  The EHCI core is then registered as
an ehci-platform device.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/mips/ali-c3503d/Makefile  |  2 +-
 arch/mips/ali-c3503d/dev-usb.c | 79 ++++++++++++++++++++++++++++++++++
 2 files changed, 80 insertions(+), 1 deletion(-)
 create mode 100644 arch/mips/ali-c3503d/dev-usb.c

diff --git a/arch/mips/ali-c3503d/Makefile b/arch/mips/ali-c3503d/Makefile
index 0b29bc12..299a5b72 100644
--- a/arch/mips/ali-c3503d/Makefile
+++ b/arch/mips/ali-c3503d/Makefile
@@ -3,3 +3,3 @@
 #
 
-obj-y := setup.o irq.o
+obj-y := setup.o irq.o dev-usb.o
diff --git a/arch/mips/ali-c3503d/dev-usb.c b/arch/mips/ali-c3503d/dev-usb.c
new file mode 100644
index 00000000..84b3384d
--- /dev/null
+++ b/arch/mips/ali-c3503d/dev-usb.c
@@ -0,0 +1,79 @@
+/*
+ * ALi C3503D USB host: wrapper and PHY set-up, and the EHCI platform device
+ *
+ *   EHCI   0xB803A100  capability block inside the ALi wrapper window
+ *                      (0xB803A000); ops at +0x110, PORTSC at +0x154, 3 ports;
+ *                      INTC bit 36.  OHCI companion at 0xB803B000 (no IRQ
+ *                      number pinned down yet, so no platform device).
+ */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/platform_device.h>
+
+#include "ali.h"
+
+/*
+ * OTP word at a byte offset (A54 0x805c1958, otp.c): wait ST bit 8 clear, ADDR, CTRL |= 0x100, wait, RDATA.
+ * Read-only; CTRL bit 0 (program trigger) is never set.
+ */
+static u32 __init ali_otp_early_word(u32 off)
+{
+	void __iomem *o = (void __iomem *)0xB8042000UL;
+	int i;
+
+	for (i = 0; i < 10000 && (readl(o + 0x10) & 0x100); i++)
+		udelay(1);
+	writel(off & 0x3ff, o + 0x04);
+	writel((readl(o + 0x0c) & ~1u) | 0x100, o + 0x0c);
+	for (i = 0; i < 10000 && (readl(o + 0x10) & 0x100); i++)
+		udelay(1);
+	return readl(o + 0x18);
+}
+
+/*
+ * USB wrapper and PHY, as the vendor maincode does them (FUN_805cdc58 in A54 V1.3B1, chip 0x3503D, strap byte 0xD0).
+ * Without this the EHCI core answers but every transaction ends in an error interrupt ("device descriptor
+ * read/64, error -32"); the loader leaves the PHY in its reset state (0xB803D810 = 0x82000000, 0xB803D824 = 0x00010000).
+ * Wrapper values also from the PDK U-Boot ehci-ali.c.  Confirmed on the box 2026-11-21: after the wrapper init the
+ * core reports HCIVERSION 0x0100, CAPLENGTH 0x20 and both ports show a connected device (PORTSC 0x1803).
+ */
+static void __init ali_usb_wrapper_init(void)
+{
+	void __iomem *w = (void __iomem *)0xB803A000UL;
+	void __iomem *phy = (void __iomem *)0xB803D800UL;
+	u32 cal, v;
+
+	writel(0x1803A100, w + 0x10);
+	writel(0x02900157, w + 0x04);
+	writel(0x00008008, w + 0x0C);
+	writel(0x1000041E, w + 0x44);
+	writel(0xC4000071, w + 0x40);
+
+	writel(0, phy + 0x04);
+	writel(0x02000000, phy + 0x10);
+	writel(0x34543454, phy + 0x14);
+	writel(0, phy + 0x18);
+	writel(0x00080000, phy + 0x24);
+	/* calibration: OTP byte 900, bits 28:16 (halfword at +2, & 0x1fff); 0 -> default 0x1d00 */
+	cal = (ali_otp_early_word(900) >> 16) & 0x1fff;
+	if (!cal) {
+		writel(0x1d00, phy + 0x2c);
+	} else {
+		v = readl(phy + 0x2c);
+		writel((v & 0xffffe0ff) | ((cal & 0x1f) << 8), phy + 0x2c);
+	}
+	mdelay(20);
+}
+
+static int __init ali_usb_init(void)
+{
+	const struct resource ehci[] = {
+		DEFINE_RES_MEM(0x1803A100UL, 0x100),
+		DEFINE_RES_IRQ(ALI_INTC_IRQ_BASE + 36),		/* INTC bit 36 */
+	};
+
+	ali_usb_wrapper_init();
+	ali_add("ehci-platform", -1, ehci, ARRAY_SIZE(ehci));	/* CAPLENGTH at +0 */
+	return 0;
+}
+arch_initcall(ali_usb_init);
