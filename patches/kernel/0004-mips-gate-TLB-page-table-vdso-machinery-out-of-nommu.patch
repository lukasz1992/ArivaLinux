diff --git a/arch/mips/include/asm/cacheflush.h b/arch/mips/include/asm/cacheflush.h
index 176de586..277ee7c3 100644
--- a/arch/mips/include/asm/cacheflush.h
+++ b/arch/mips/include/asm/cacheflush.h
@@ -98,4 +98,5 @@ static inline void flush_cache_vunmap(unsigned long start, unsigned long end)
 }
 
+#ifdef CONFIG_MMU
 extern void copy_to_user_page(struct vm_area_struct *vma,
 	struct page *page, unsigned long vaddr, void *dst, const void *src,
@@ -105,4 +106,18 @@ extern void copy_from_user_page(struct vm_area_struct *vma,
 	struct page *page, unsigned long vaddr, void *dst, const void *src,
 	unsigned long len);
+#else
+/*
+ * No MMU: user addresses are the kernel's own, there is no aliasing through a user mapping, and mm/nommu.c passes
+ * page == NULL here.  The MMU version dereferences that page (page_mapped(NULL)): on the ALi C3503D that reads
+ * from KUSEG, which is not backed by anything, and hangs the bus (cat /proc/<pid>/cmdline, ps).
+ */
+#define copy_to_user_page(vma, page, vaddr, dst, src, len)			\
+do {										\
+	memcpy((dst), (src), (len));						\
+	flush_icache_range((unsigned long)(dst), (unsigned long)(dst) + (len));	\
+} while (0)
+#define copy_from_user_page(vma, page, vaddr, dst, src, len)			\
+	memcpy((dst), (src), (len))
+#endif
 
 extern void (*flush_cache_sigtramp)(unsigned long addr);
