 					  ksig, regs, oldset);
@@ -800,4 +831,11 @@ static void handle_signal(struct ksignal *ksig, struct pt_regs *regs)
 		ret = abi->setup_frame(vdso + abi->vdso->off_sigreturn,
 				       ksig, regs, oldset);
+#else
+		ret = abi->setup_rt_frame((void *)__nommu_rt_sigreturn,
+					  ksig, regs, oldset);
+	else
