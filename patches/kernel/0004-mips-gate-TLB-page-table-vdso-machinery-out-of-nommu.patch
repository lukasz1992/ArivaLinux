+++ b/arch/mips/kernel/signal.c
@@ -43,4 +43,31 @@
 #include "signal-common.h"
 
+#ifdef CONFIG_MIPS_NOMMU
+#include <linux/stringify.h>
+/*
+ * No vdso on nommu: userland runs in kernel mode, so the sigreturn
+ * trampoline can simply live in kernel text.  Both the rt and the
+ * trad (o32) stubs are provided; musl only ever takes the rt path.
+ */
+extern void __nommu_sigreturn(void);
+extern void __nommu_rt_sigreturn(void);
+
+asm(
+"	.text\n"
+"	.globl	__nommu_sigreturn\n"
+"	.type	__nommu_sigreturn, @function\n"
+"__nommu_sigreturn:\n"
+"	li	$2, " __stringify(__NR_sigreturn) "\n"
+"	syscall\n"
+"	break	0\n"		/* sigreturn does not return; do not fall into the next stub */
+"	.globl	__nommu_rt_sigreturn\n"
+"	.type	__nommu_rt_sigreturn, @function\n"
+"__nommu_rt_sigreturn:\n"
+"	li	$2, " __stringify(__NR_rt_sigreturn) "\n"
+"	syscall\n"
+"	break	0\n"
+);
+#endif
