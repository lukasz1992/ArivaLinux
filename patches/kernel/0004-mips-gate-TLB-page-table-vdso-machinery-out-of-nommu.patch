diff --git a/arch/mips/mm/ioremap-nommu.c b/arch/mips/mm/ioremap-nommu.c
new file mode 100644
index 00000000..8f483015
--- /dev/null
+++ b/arch/mips/mm/ioremap-nommu.c
@@ -0,0 +1,55 @@
+/*
+ * This file is subject to the terms and conditions of the GNU General Public
+ * License.  See the file "COPYING" in the main directory of this archive
+ * for more details.
+ *
+ * Copyright (C) 2026 ALiLinux project
+ *
+ * No-MMU ioremap: there are no page tables to remap into, so device
+ * windows are only reachable through the fixed kseg1 mapping, which
+ * covers the low 512 MB of physical address space uncached.  Anything
+ * outside that window (and any request for a cachable mapping) cannot
+ * be served and is rejected.
+ */
+#include <linux/export.h>
+#include <linux/mm.h>
+#include <linux/init.h>
+
+#include <asm/addrspace.h>
+#include <asm/io.h>
+
+#define IS_LOW512(addr)	(!((phys_addr_t)(addr) & (phys_addr_t) ~0x1fffffffULL))
+#define IS_KSEG1(addr)	(((unsigned long)(addr) & ~0x1fffffffUL) == CKSEG1)
+
+void __iomem * __ioremap(phys_addr_t phys_addr, phys_addr_t size,
+	unsigned long flags)
+{
+	phys_addr_t last_addr = phys_addr + size - 1;
+
+	/* Don't allow wraparound or zero size. */
+	if (!size || last_addr < phys_addr)
+		return NULL;
+
+	if (flags != _CACHE_UNCACHED ||
+	    !(IS_LOW512(phys_addr) && IS_LOW512(last_addr))) {
+		WARN_ONCE(1, "ioremap(0x%pa, 0x%pa): no fixed kseg1 window "
+			  "for this address\n", &phys_addr, &last_addr);
+		return NULL;
+	}
+
+	return (void __iomem *) CKSEG1ADDR(phys_addr);
+}
+EXPORT_SYMBOL(__ioremap);
+
+void __iounmap(const volatile void __iomem *addr)
+{
+	/*
+	 * Everything ioremap() hands out here is a fixed kseg1 window,
+	 * nothing to unmap.  The generic iounmap() only calls us when
+	 * the address is not a statically-known kseg1 address; warn on
+	 * anything else.
+	 */
+	if (!IS_KSEG1(addr))
+		WARN_ONCE(1, "iounmap: bad address %p\n", addr);
+}
+EXPORT_SYMBOL(__iounmap);
