diff --git a/arch/mips/mm/c-r4k.c b/arch/mips/mm/c-r4k.c
index 90f8d6d5..a88a6a6c 100644
--- a/arch/mips/mm/c-r4k.c
+++ b/arch/mips/mm/c-r4k.c
@@ -465,4 +465,5 @@ static void r4k___flush_cache_all(void)
 }
 
+#ifdef CONFIG_MMU
 static inline int has_valid_asid(const struct mm_struct *mm)
 {
@@ -479,4 +480,5 @@ static inline int has_valid_asid(const struct mm_struct *mm)
 #endif
 }
+#endif /* CONFIG_MMU */
 
 static void r4k__flush_cache_vmap(void)
@@ -490,4 +492,5 @@ static void r4k__flush_cache_vunmap(void)
 }
 
+#ifdef CONFIG_MMU
 static inline void local_r4k_flush_cache_range(void * args)
 {
@@ -637,4 +640,26 @@ static void r4k_flush_cache_page(struct vm_area_struct *vma,
 	r4k_on_each_cpu(local_r4k_flush_cache_page, &args);
 }
+#else /* !CONFIG_MMU */
+/*
+ * No-MMU: there are no page tables to walk and the fixed-mapping cores
+ * have alias-free caches (cpu_has_dc_aliases == 0), so there is no D-cache
+ * work.  The I-cache is still not coherent: an executable mapping that was
+ * written to (ptrace POKETEXT -> copy_to_user_page(), a loader) must have its
+ * I-cache lines dropped, as the MMU versions do for VM_EXEC.
+ */
+static void r4k_flush_cache_mm(struct mm_struct *mm) { }
+static void r4k_flush_cache_range(struct vm_area_struct *vma,
+	unsigned long start, unsigned long end)
+{
+	if (vma->vm_flags & VM_EXEC)
+		flush_icache_range(start, end);
+}
+static void r4k_flush_cache_page(struct vm_area_struct *vma,
+	unsigned long addr, unsigned long pfn)
+{
+	if (vma->vm_flags & VM_EXEC)
+		flush_icache_range(addr & PAGE_MASK, (addr & PAGE_MASK) + PAGE_SIZE);
+}
+#endif /* CONFIG_MMU */
 
 static inline void local_r4k_flush_data_cache_page(void * addr)
