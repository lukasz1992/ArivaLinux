+# to refill); keep the cache files unconditional.
+mmu-tlb-$(CONFIG_MMU)		:= tlb-r4k.o
+
+obj-$(CONFIG_CPU_R4K_CACHE_TLB) += c-r4k.o cex-gen.o $(mmu-tlb-y)
 obj-$(CONFIG_CPU_R3000)		+= c-r3k.o tlb-r3k.o
 obj-$(CONFIG_CPU_R8000)		+= c-r4k.o cex-gen.o tlb-r8k.o
