+# Page-table and TLB machinery only exists on MMU builds; the
+# fault/mmap/gup side of the mm comes from mm/nommu.c there.
+# (Variable names deliberately do not match the .o basenames --
+# Kbuild would treat <name>-y as composite-object parts.)
+# As in the original: 32-bit takes pgtable-32.o + ioremap.o, 64-bit pgtable-64.o; the MMU
+# gate is the obj-$(CONFIG_MMU) line.
+mmu-pg-$(CONFIG_32BIT)		:= pgtable-32.o ioremap.o
+mmu-pg-$(CONFIG_64BIT)		:= pgtable-64.o
+obj-$(CONFIG_MMU)		+= fault.o gup.o mmap.o tlbex.o tlbex-fault.o \
+				   tlb-funcs.o $(mmu-pg-y)
