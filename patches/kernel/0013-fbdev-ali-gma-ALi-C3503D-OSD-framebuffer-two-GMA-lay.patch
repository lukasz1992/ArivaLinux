From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz M <lukasz1992m+alilinux@gmail.com>
Date: Sun, 22 Nov 2026 12:41:36 +0100
Subject: [PATCH] fbdev: ali-gma: ALi C3503D OSD framebuffer (two GMA
 layers)

A 1280x720 ARGB1555 bitmap per layer, shown through a 720x576 window.
Layer 0 is fb0 and on at probe, layer 1 is fb1 and off until unblanked
(echo 0 > /sys/class/graphics/fb1/blank); a per-layer "alpha" attribute
sets the constant layer alpha.  The nommu ioremap and asm/fb.h hooks give
the driver the uncached KSEG1 view of the bitmap.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/mips/ali-c3503d/Makefile  |   2 +-
 arch/mips/ali-c3503d/dev-gma.c |  21 +++
 arch/mips/include/asm/fb.h     |   8 ++
 arch/mips/mm/ioremap-nommu.c   |  27 ++++
 drivers/video/fbdev/Kconfig    |  11 ++
 drivers/video/fbdev/Makefile   |   1 +
 drivers/video/fbdev/ali-gma.c  | 255 +++++++++++++++++++++++++++++++++
 7 files changed, 324 insertions(+), 1 deletion(-)
 create mode 100644 arch/mips/ali-c3503d/dev-gma.c
 create mode 100644 drivers/video/fbdev/ali-gma.c

diff --git a/arch/mips/ali-c3503d/Makefile b/arch/mips/ali-c3503d/Makefile
index 48475dba..fdf3a0fd 100644
--- a/arch/mips/ali-c3503d/Makefile
+++ b/arch/mips/ali-c3503d/Makefile
@@ -3,3 +3,3 @@
 #
 
-obj-y := setup.o irq.o dev-usb.o dev-flash.o
+obj-y := setup.o irq.o dev-usb.o dev-flash.o dev-gma.o
diff --git a/arch/mips/ali-c3503d/dev-gma.c b/arch/mips/ali-c3503d/dev-gma.c
new file mode 100644
index 00000000..d83dc9bb
--- /dev/null
+++ b/arch/mips/ali-c3503d/dev-gma.c
@@ -0,0 +1,21 @@
+/*
+ * ALi C3503D OSD layers (GMA) for drivers/video/fbdev/ali-gma.c
+ *
+ * Layer 0 (register block 0x18006300) becomes fb0 and is on after probe;
+ * layer 1 (0x18006380) becomes fb1 and stays off until it is unblanked.
+ */
+#include <linux/init.h>
+#include <linux/platform_device.h>
+
+#include "ali.h"
+
+static int __init ali_gma_init(void)
+{
+	const struct resource gma0 = DEFINE_RES_MEM(0x18006300UL, 0x10);	/* layer F */
+	const struct resource gma1 = DEFINE_RES_MEM(0x18006380UL, 0x10);	/* layer S */
+
+	ali_add("ali-gma", 0, &gma0, 1);
+	ali_add("ali-gma", 1, &gma1, 1);
+	return 0;
+}
+arch_initcall(ali_gma_init);
diff --git a/arch/mips/include/asm/fb.h b/arch/mips/include/asm/fb.h
index bd3f68c9..0addf01f 100644
--- a/arch/mips/include/asm/fb.h
+++ b/arch/mips/include/asm/fb.h
@@ -12,4 +12,12 @@ static inline void fb_pgprotect(struct file *file, struct vm_area_struct *vma,
 }
 
+#ifndef CONFIG_MMU
+/* nommu: mmap of a framebuffer hands out its uncached KSEG1 view (arch/mips/mm/ioremap-nommu.c) */
+#define HAVE_ARCH_FB_UNMAPPED_AREA
+extern unsigned long get_fb_unmapped_area(struct file *filp, unsigned long orig_addr,
+					  unsigned long len, unsigned long pgoff,
+					  unsigned long flags);
+#endif
+
 static inline int fb_is_primary_device(struct fb_info *info)
 {
diff --git a/arch/mips/mm/ioremap-nommu.c b/arch/mips/mm/ioremap-nommu.c
index 8f483015..261cfbcf 100644
--- a/arch/mips/mm/ioremap-nommu.c
+++ b/arch/mips/mm/ioremap-nommu.c
@@ -13,4 +13,6 @@
  */
 #include <linux/export.h>
+#include <linux/fb.h>
+#include <linux/fs.h>
 #include <linux/mm.h>
 #include <linux/init.h>
@@ -54,2 +56,27 @@ void __iounmap(const volatile void __iomem *addr)
 }
 EXPORT_SYMBOL(__iounmap);
+
+#ifdef CONFIG_FB
+/*
+ * mmap() of /dev/fbN on nommu: the mapping is the framebuffer's own memory
+ * through the fixed uncached KSEG1 window (the same view /dev/mem hands out,
+ * accepted by remap_pfn_range() in mm/nommu.c).  Needs smem_start in the low
+ * 512 MB, as for ioremap above.
+ */
+unsigned long get_fb_unmapped_area(struct file *filp, unsigned long orig_addr,
+				   unsigned long len, unsigned long pgoff,
+				   unsigned long flags)
+{
+	struct fb_info *info = filp->private_data;
+	unsigned long start, size, off = pgoff << PAGE_SHIFT;
+
+	if (!info)
+		return (unsigned long) -ENODEV;
+	start = info->fix.smem_start & PAGE_MASK;
+	size = PAGE_ALIGN(info->fix.smem_len + (info->fix.smem_start & ~PAGE_MASK));
+	if (off > size || len > size - off || !IS_LOW512(start + size - 1))
+		return (unsigned long) -EINVAL;
+	return CKSEG1ADDR(start + off);
+}
+EXPORT_SYMBOL(get_fb_unmapped_area);
+#endif
