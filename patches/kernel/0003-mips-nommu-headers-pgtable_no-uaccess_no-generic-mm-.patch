+#ifndef _ASM_PGTABLE_NO_H
+#define _ASM_PGTABLE_NO_H
+
+/*
+ * Trivial page tables for the no-MMU (fixed mapping, Config0.MT == 3)
+ * MIPS build: the core maps kseg0 and kuseg statically, so Linux never
+ * touches page tables.  The stubs below keep the generic mm code happy.
+ * Modelled on arch/m68k/include/asm/pgtable_no.h and the nommu branch
+ * of arch/microblaze/include/asm/pgtable.h.
+ */
+
+#include <linux/mm_types.h>
+#include <asm/page.h>
+
+/*
+ * pud_* is folded onto pgd_* (4-level fixup); pmd_t exists only so
+ * that generic declarations compile -- nothing allocates or walks
+ * page tables here.
+ */
+#include <asm-generic/4level-fixup.h>
+typedef struct { unsigned long pmd[16]; } pmd_t;
+#define pmd_val(x)	((x).pmd[0])
+
+#define pgd_present(pgd)	(1)
+#define pgd_none(pgd)		(0)
+#define pgd_bad(pgd)		(0)
+#define pgd_clear(pgdp)
+#define kern_addr_valid(addr)	(1)
+#define pmd_offset(a, b)	((void *)0)
+
+#define PAGE_NONE	__pgprot(0)
+#define PAGE_SHARED	__pgprot(0)
+#define PAGE_COPY	__pgprot(0)
+#define PAGE_READONLY	__pgprot(0)
+#define PAGE_KERNEL	__pgprot(0)
+#define PAGE_USERIO	__pgprot(0)
+
+/* Cache attributes are per-address-segment, not per-pte. */
+#define pgprot_noncached(prot)		(prot)
+#define pgprot_writecombine(prot)	(prot)
+
+extern void paging_init(void);
+#define swapper_pg_dir		((pgd_t *) NULL)
+
+#define __swp_type(x)		(0)
+#define __swp_offset(x)		(0)
+#define __swp_entry(typ, off)	((swp_entry_t) { ((typ) | ((off) << 7)) })
+#define __pte_to_swp_entry(pte)	((swp_entry_t) { pte_val(pte) })
+#define __swp_entry_to_pte(x)	((pte_t) { (x).val })
+
+/*
+ * No zero page on nommu: mm/nommu.c never maps it.  Make accidental
+ * uses fail loudly instead of silently handing out kernel pages.
+ */
+#define ZERO_PAGE(vaddr)	({ BUG(); NULL; })
+
+#define update_mmu_cache(vma, address, ptep)	do { } while (0)
+
+/*
+ * No page table caches to initialise.
+ */
+#define pgtable_cache_init()	do { } while (0)
+
+/*
+ * All 32bit addresses are effectively valid for vmalloc... sort of
+ * meaningless for non-VM targets.
+ */
+#define VMALLOC_START		0UL
+#define VMALLOC_END		0xffffffffUL
+
+#include <asm-generic/pgtable.h>
+
+#define check_pgt_cache()	do { } while (0)
+
+#endif /* _ASM_PGTABLE_NO_H */
