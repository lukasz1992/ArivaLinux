diff --git a/arch/mips/include/asm/pgtable_no.h b/arch/mips/include/asm/pgtable_no.h
new file mode 100644
index 00000000..f43ab3aa
--- /dev/null
+++ b/arch/mips/include/asm/pgtable_no.h
@@ -0,0 +1,82 @@
+/*
+ * This file is subject to the terms and conditions of the GNU General Public
+ * License.  See the file "COPYING" in the main directory of this archive
+ * for more details.
+ *
+ * Copyright (C) 2026 ALiLinux project
