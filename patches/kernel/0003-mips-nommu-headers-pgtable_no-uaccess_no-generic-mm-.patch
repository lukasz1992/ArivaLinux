 }
+
+#ifndef CONFIG_MMU
+#include <linux/mm.h>
+#include <asm/addrspace.h>
+#include <asm/page.h>
+
+/*
+ * nommu access_ok(): RAM through the cached KSEG0 view (everything a process owns lives there,
+ * the kernel image too, for KERNEL_DS) and the uncached KSEG1 view that /dev/mem and /dev/fb
+ * hand out.  NULL, wild and wrapping pointers get -EFAULT instead of silently reading or writing
+ * physical memory (the exception vectors are at physical 0).  Before mem_init() high_memory is
+ * still NULL: RAM is accepted as a whole then.
+ */
+int __access_ok(unsigned long addr, unsigned long size)
+{
+	unsigned long end = addr + size;
+
+	if (!size)		/* nothing is accessed (NULL, 0 is legal, as with an MMU) */
+		return 1;
+	if (end < addr)
+		return 0;
+	if (addr >= CKSEG0 && addr < CKSEG1)
+		return end <= CKSEG1 && (!high_memory || end <= (unsigned long)high_memory);
+	if (addr >= CKSEG1 && addr < CKSEG2)
+		return end <= CKSEG2;
+	return 0;
+}
+EXPORT_SYMBOL(__access_ok);
+#endif
