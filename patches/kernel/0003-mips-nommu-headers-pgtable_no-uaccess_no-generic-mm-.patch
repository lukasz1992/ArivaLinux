@@ -0,0 +1,19 @@
+#ifndef _ASM_UACCESS_NO_H
+#define _ASM_UACCESS_NO_H
+/* nommu: userland runs in kernel mode, "user" pointers are kernel pointers */
+#include <asm/addrspace.h>
+#include <asm/page.h>
+
+extern void *high_memory;
+
+/*
+ * There is no MMU to fault a bad pointer, so access_ok() checks the range (arch/mips/mm/extable.c:
+ * RAM through KSEG0 and the uncached KSEG1 view), out of line -- it has hundreds of users.
+ */
+extern int __access_ok(unsigned long addr, unsigned long size);
+#define __access_ok __access_ok
+
+#include <asm-generic/uaccess.h>
+
+extern int fixup_exception(struct pt_regs *regs);
+#endif
