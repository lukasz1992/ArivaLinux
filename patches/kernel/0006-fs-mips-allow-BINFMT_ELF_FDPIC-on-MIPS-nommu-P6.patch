From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz M <lukasz1992m+alilinux@gmail.com>
Date: Tue, 17 Nov 2026 18:13:20 +0100
Subject: [PATCH] fs, mips: allow BINFMT_ELF_FDPIC on MIPS nommu: P6

fs/Kconfig.binfmt: BINFMT_ELF_FDPIC also on (MIPS && !MMU).  The
no-MMU path of fs/binfmt_elf_fdpic.c is exactly what this port needs:
binfmt_elf.c refuses a file without ->mmap (initramfs has none), while
the fdpic loader's elf_fdpic_map_file_constdisp_on_uclinux() allocates
one anonymous block (vm_mmap of NULL), copies the PT_LOADs in with
read_code() and clears the bss tails -- no file mmap anywhere.  A
non-FDPIC ET_DYN (a plain static PIE) is accepted under !MMU
(is_constdisp() -> CONSTDISP arrangement) and start_thread() gets
(entry_addr computed from e_entry within the mapped segment,
mm->start_stack).

arch/mips/include/asm/mmu.h: the nommu mm_context_t gains the
exec/interp_fdpic_loadmap fields (as asm-generic/mmu.h has them under
CONFIG_BINFMT_ELF_FDPIC) -- binfmt_elf_fdpic stores the loadmaps there
and the core dumper reads them.

arch/mips/include/asm/elf.h: ELF_FDPIC_CORE_EFLAGS 0 (no MIPS FDPIC
flag bits).  elf_check_fdpic() stays undefined, so its weak default 0
applies: is_constdisp() is true and no PER_LINUX_FDPIC personality is
set -- an ordinary static PIE, with rcrt1.o doing its own self
relocation ( included).  elf_check_arch() already accepts o32
ET_DYN.  No ELF_FDPIC_PLAT_INIT: nothing to stuff into a1..a3.

arch/mips/include/uapi/asm/ptrace.h: PTRACE_GETFDPIC{,_EXEC,_INTERP}
(kernel/ptrace.c grows that request under CONFIG_BINFMT_ELF_FDPIC),
numbered like the other FDPIC platforms.

arch_pick_mmap_layout is a static inline no-op under !CONFIG_MMU
(sched.h), so no MIPS-side definition is needed; mm/nommu.c owns
placement (private mappings are alloc_pages_exact copies).

Verified: nommu build with BINFMT_ELF_FDPIC=y; malta MMU=y regression
(depends keep fdpic off).
---
 arch/mips/include/asm/elf.h         | 13 +++++++++++++
 arch/mips/include/asm/mmu.h         |  7 +++++++
 arch/mips/include/uapi/asm/ptrace.h |  9 +++++++++
 fs/Kconfig.binfmt                   |  8 +++++++-
 4 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/arch/mips/include/asm/elf.h b/arch/mips/include/asm/elf.h
index 5ad05a14..c7008538 100644
--- a/arch/mips/include/asm/elf.h
+++ b/arch/mips/include/asm/elf.h
@@ -248,4 +248,17 @@ struct mips_elf_abiflags_v0 {
 #define ELF_CLASS	ELFCLASS32
 
+/*
+ * FDPIC ELF core dumps (BINFMT_ELF_FDPIC): the MIPS ABI has no FDPIC
+ * flag bits of its own.
+ */
+#define ELF_FDPIC_CORE_EFLAGS	0
+
+/* a new image must not start with the previous program's registers; the MIPS ABI passes
+ * the rtld_fini pointer in $2 (v0), 0 = none */
+#define ELF_FDPIC_PLAT_INIT(_regs, _exec_map_addr, _interp_map_addr, _dynamic_addr)	\
+	do {										\
+		(_regs)->regs[2] = 0;							\
+	} while (0)
+
 #endif /* CONFIG_32BIT */
 
diff --git a/arch/mips/include/asm/mmu.h b/arch/mips/include/asm/mmu.h
index df6fadc4..39d83d9a 100644
--- a/arch/mips/include/asm/mmu.h
+++ b/arch/mips/include/asm/mmu.h
@@ -18,4 +18,7 @@ typedef struct {
  * end_brk for sys_brk() in mm/nommu.c.  fp_mode_switching is shared
  * with the MMU header: prctl(PR_SET_FP_MODE) still touches it.
+ *
+ * The FDPIC loadmaps are what binfmt_elf_fdpic stores (and the core
+ * dumper reads) instead of page tables, same as asm-generic/mmu.h.
  */
 #include <linux/atomic.h>
@@ -23,4 +26,8 @@ typedef struct {
 typedef struct {
 	unsigned long end_brk;
+#ifdef CONFIG_BINFMT_ELF_FDPIC
+	unsigned long exec_fdpic_loadmap;
+	unsigned long interp_fdpic_loadmap;
+#endif
 	atomic_t fp_mode_switching;
 } mm_context_t;
diff --git a/arch/mips/include/uapi/asm/ptrace.h b/arch/mips/include/uapi/asm/ptrace.h
index 91a3d197..2629bb34 100644
--- a/arch/mips/include/uapi/asm/ptrace.h
+++ b/arch/mips/include/uapi/asm/ptrace.h
@@ -60,4 +60,13 @@ struct pt_regs {
 #define PTRACE_SET_THREAD_AREA	26
 
+/* FDPIC ELF (BINFMT_ELF_FDPIC, no-MMU MIPS only): the loadmap numbers
+ * match the other FDPIC platforms (frv, blackfin, sh). */
+#ifdef CONFIG_BINFMT_ELF_FDPIC
+#define PTRACE_GETFDPIC		31	/* get the ELF fdpic loadmap address */
+
+#define PTRACE_GETFDPIC_EXEC	0	/* [addr] request the executable loadmap */
+#define PTRACE_GETFDPIC_INTERP	1	/* [addr] request the interpreter loadmap */
+#endif
+
 /* Calls to trace a 64bit program from a 32bit program.	 */
 #define PTRACE_PEEKTEXT_3264	0xc0
diff --git a/fs/Kconfig.binfmt b/fs/Kconfig.binfmt
index 72c03354..88a00a0e 100644
--- a/fs/Kconfig.binfmt
+++ b/fs/Kconfig.binfmt
@@ -36,5 +36,5 @@ config BINFMT_ELF_FDPIC
 	bool "Kernel support for FDPIC ELF binaries"
 	default y
-	depends on (FRV || BLACKFIN || (SUPERH32 && !MMU) || C6X)
+	depends on (FRV || BLACKFIN || (SUPERH32 && !MMU) || C6X) || (MIPS && !MMU)
 	select ELFCORE
 	help
@@ -45,4 +45,10 @@ config BINFMT_ELF_FDPIC
 	  even if data segments are not.
 
+	  On MIPS with no MMU (MIPS_NOMMU: fixed mapping, userland runs in
+	  kernel mode) this is also the only loader that can place a normal
+	  PIE ELF (ET_DYN) anywhere in memory: it allocates one anonymous
+	  block, copies the segments in and relocates, so no file mmap is
+	  needed.
+
 	  It is also possible to run FDPIC ELF binaries on MMU linux also.
 
