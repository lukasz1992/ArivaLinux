diff --git a/drivers/media/rc/ali-ir.c b/drivers/media/rc/ali-ir.c
new file mode 100644
index 00000000..114add5a
--- /dev/null
+++ b/drivers/media/rc/ali-ir.c
@@ -0,0 +1,153 @@
+/*
+ * ALi M6303 IR receiver (IRC, 0x18018100 on the C3503D / Ferguson Ariva 54).
+ *
+ * The controller measures the receiver output and queues one byte per run
+ * in a FIFO: bit 7 the line level (0 = mark, the receiver is active low),
+ * bits 0..6 the length in 8 us work-clock ticks (a longer run takes several
+ * bytes of the same level).  ISR bit 0 = FIFO over threshold, bit 1 = the
+ * line stayed idle for the timeout (a frame ended); write 1 to clear.
+ * Set-up as the vendor's irc_m6303irc_init / the A54 firmware (IRCCFG 0x83);
+ * see also maciej_app demo/ir.c.  Runs go to rc-core as raw pulse/space
+ * events; rc-core's NEC decoder and the keymap named by the platform data
+ * turn them into keys.
+ *
+ * Licensed under the GPLv2.
+ */
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/platform_data/ali-ir.h>
+#include <media/rc-core.h>
+
+#define IRC_CFG		0
+#define IRC_FIFOCTRL	1
+#define IRC_TIMETHR	2
+#define IRC_NOISETHR	3
+#define IRC_IER		6
+#define IRC_ISR		7
+#define IRC_RLC		8
+
+#define TICK_US		8
+#define IDLE_US		24000
+
+struct ali_ir {
+	void __iomem *base;
+	struct rc_dev *rc;
+};
+
+static irqreturn_t ali_ir_irq(int irq, void *data)
+{
+	struct ali_ir *ir = data;
+	u8 st, n;
+	int budget = 128;		/* never spin in the handler if FIFOCTRL does not drain */
+
+	st = readb(ir->base + IRC_ISR) & 3;
+	if (!st)
+		return IRQ_NONE;
+	writeb(st, ir->base + IRC_ISR);
+	while (budget && (n = readb(ir->base + IRC_FIFOCTRL) & 0x7f)) {
+		while (n-- && budget) {
+			u8 b = readb(ir->base + IRC_RLC);
+			DEFINE_IR_RAW_EVENT(ev);
+
+			ev.pulse = !(b & 0x80);
+			ev.duration = US_TO_NS((b & 0x7f) * TICK_US);
+			ir_raw_event_store_with_filter(ir->rc, &ev);
+			budget--;
+		}
+	}
+	if (st & 2) {			/* frame over: the idle timeout */
+		DEFINE_IR_RAW_EVENT(ev);
+
+		ev.pulse = false;
+		ev.duration = US_TO_NS(IDLE_US);
+		ir_raw_event_store_with_filter(ir->rc, &ev);
+		ir_raw_event_set_idle(ir->rc, true);
+	}
+	ir_raw_event_handle(ir->rc);
+	return IRQ_HANDLED;
+}
+
+static void ali_ir_hw_init(struct ali_ir *ir)
+{
+	writeb(0, ir->base + IRC_CFG);
+	writeb(0x80 | 3, ir->base + IRC_CFG);			/* on, 8 us ticks */
+	writeb(0xa0, ir->base + IRC_FIFOCTRL);			/* threshold 32 */
+	writeb(IDLE_US / (TICK_US << 7) - 1, ir->base + IRC_TIMETHR);
+	writeb(80 / TICK_US, ir->base + IRC_NOISETHR);		/* < 80 us = noise */
+	writeb(3, ir->base + IRC_ISR);
+	writeb(3, ir->base + IRC_IER);
+}
+
+static int ali_ir_probe(struct platform_device *pdev)
+{
+	struct ali_ir *ir;
+	struct resource *res;
+	struct rc_dev *rc;
+	const struct ali_ir_platform_data *pdata = dev_get_platdata(&pdev->dev);
+	int irq, ret;
+
+	ir = devm_kzalloc(&pdev->dev, sizeof(*ir), GFP_KERNEL);
+	if (!ir)
+		return -ENOMEM;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	ir->base = devm_ioremap_resource(&pdev->dev, res);
+	if (IS_ERR(ir->base))
+		return PTR_ERR(ir->base);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	rc = rc_allocate_device();
+	if (!rc)
+		return -ENOMEM;
+	rc->priv = ir;
+	rc->driver_type = RC_DRIVER_IR_RAW;
+	rc->input_name = "ALi IR receiver";
+	rc->input_phys = "ali-ir/input0";
+	rc->input_id.bustype = BUS_HOST;
+	rc->dev.parent = &pdev->dev;
+	rc->driver_name = "ali-ir";
+	rc->map_name = pdata && pdata->map_name ? pdata->map_name : RC_MAP_EMPTY;
+	rc->allowed_protocols = RC_BIT_ALL;
+	rc->rx_resolution = US_TO_NS(TICK_US);
+	rc->timeout = US_TO_NS(IDLE_US);
+	ir->rc = rc;
+
+	ret = rc_register_device(rc);
+	if (ret)
+		goto err_free;
+	platform_set_drvdata(pdev, ir);
+	/* the handler must exist before the bootloader's IER (3) can raise the line */
+	ret = devm_request_irq(&pdev->dev, irq, ali_ir_irq, 0, "ali-ir", ir);
+	if (ret)
+		goto err_unreg;
+	ali_ir_hw_init(ir);
+	return 0;
+
+err_unreg:
+	rc_unregister_device(rc);
+	return ret;
+err_free:
+	rc_free_device(rc);
+	return ret;
+}
+
+static int ali_ir_remove(struct platform_device *pdev)
+{
+	struct ali_ir *ir = platform_get_drvdata(pdev);
+
+	writeb(0, ir->base + IRC_IER);
+	rc_unregister_device(ir->rc);
+	return 0;
+}
+
+static struct platform_driver ali_ir_driver = {
+	.probe	= ali_ir_probe,
+	.remove	= ali_ir_remove,
+	.driver	= { .name = "ali-ir" },
+};
+module_platform_driver(ali_ir_driver);
+MODULE_ALIAS("platform:ali-ir");
+MODULE_LICENSE("GPL");
diff --git a/include/linux/platform_data/ali-ir.h b/include/linux/platform_data/ali-ir.h
new file mode 100644
index 00000000..1c31a1a1
--- /dev/null
+++ b/include/linux/platform_data/ali-ir.h
@@ -0,0 +1,9 @@
+#ifndef __LINUX_PLATFORM_DATA_ALI_IR_H
+#define __LINUX_PLATFORM_DATA_ALI_IR_H
+
+/* Platform data of the ali-ir receiver: which rc keymap the board's remote uses. */
+struct ali_ir_platform_data {
+	const char *map_name;		/* RC_MAP_*, NULL for an empty keymap */
+};
+
+#endif
