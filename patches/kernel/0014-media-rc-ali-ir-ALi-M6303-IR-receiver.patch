diff --git a/arch/mips/ali-c3503d/ali.h b/arch/mips/ali-c3503d/ali.h
index 219ebda6..edc1604a 100644
--- a/arch/mips/ali-c3503d/ali.h
+++ b/arch/mips/ali-c3503d/ali.h
@@ -27,4 +27,5 @@ struct ali_board {
 	const struct mtd_partition *flash_parts;
 	unsigned int nr_flash_parts;
+	const char *ir_map;			/* rc keymap (RC_MAP_*) of the board's remote */
 	void (*init)(void);			/* register board-specific devices */
 };
diff --git a/arch/mips/ali-c3503d/dev-ir.c b/arch/mips/ali-c3503d/dev-ir.c
new file mode 100644
index 00000000..4bf61fd0
--- /dev/null
+++ b/arch/mips/ali-c3503d/dev-ir.c
@@ -0,0 +1,24 @@
+/*
+ * ALi C3503D IR receiver (M6303 IRC) platform device
+ *
+ * The remote's keymap is a property of the board: ali_board.ir_map.
+ */
+#include <linux/init.h>
+#include <linux/platform_data/ali-ir.h>
+#include <linux/platform_device.h>
+
+#include "ali.h"
+
+static int __init ali_ir_init(void)
+{
+	const struct resource ir[] = {
+		DEFINE_RES_MEM(0x18018100UL, 0x10),
+		DEFINE_RES_IRQ(ALI_INTC_IRQ_BASE + 19),		/* INTC bit 19 */
+	};
+	struct ali_ir_platform_data data = { .map_name = ali_board.ir_map };
+
+	WARN_ON(IS_ERR(platform_device_register_resndata(NULL, "ali-ir", -1,
+			ir, ARRAY_SIZE(ir), &data, sizeof(data))));
+	return 0;
+}
+arch_initcall(ali_ir_init);
