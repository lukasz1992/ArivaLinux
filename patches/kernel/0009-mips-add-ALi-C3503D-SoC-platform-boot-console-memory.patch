index 59b39994..31bf5d96 100644
--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -87,4 +87,26 @@ config MIPS_ALCHEMY
 	select COMMON_CLK
 
+config MIPS_ALI_C3503D
+	bool "ALi C3503D based set-top boxes"
+	select BOOT_RAW
+	select CEVT_R4K
+	select CSRC_R4K
+	select DMA_NONCOHERENT	# the 4Kc caches are not coherent with the USB/GE/DMA engines
+	select IRQ_MIPS_CPU
