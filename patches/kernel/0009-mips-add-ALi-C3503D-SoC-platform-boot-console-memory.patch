+#ifndef __ASM_MACH_ALI_SPACES_H
+#define __ASM_MACH_ALI_SPACES_H
+
+#include <asm/mach-generic/spaces.h>
+
+#endif /* __ASM_MACH_ALI_SPACES_H */
