diff --git a/arch/mips/include/asm/mach-ali/spaces.h b/arch/mips/include/asm/mach-ali/spaces.h
new file mode 100644
index 00000000..5742b1bd
--- /dev/null
+++ b/arch/mips/include/asm/mach-ali/spaces.h
@@ -0,0 +1,10 @@
